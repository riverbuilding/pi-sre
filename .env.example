# Optional single application root; defaults to ~/.pi-sre.
# PI_SRE_HOME=~/.pi-sre

# Optional path to the Pi SRE configuration file; defaults to
# $PI_SRE_HOME/config.yaml. Relative paths resolve from the launch directory.
# PI_SRE_CONFIG=./config/pi-sre.example.yaml

# Optional override for the Kubernetes MCP executable.
# PI_SRE_MCP_COMMAND=kubernetes-mcp-server
